// device_read — a reading loop for a QMC5883L on a breakout, for an nRF52840 DK
// or an nRF54LM20 DK.
//
// The breakout's SDA and SCL go to the board's I2C pins; the part's address is
// fixed at 0x0D.  DRDY goes to a free GPIO, if the program is to read the
// data-ready line.  The program brings the part up in continuous mode at 10 Hz
// and ±2 gauss and prints one line per sample over RTT:
//
//     qmc5883l x=<nanotesla> y=<nanotesla> z=<nanotesla>
//
// The Earth's field is between 25 000 and 65 000 nanotesla.
//
// Build it with `novo build --target=nrf52840-dk tests/device_read.nv` or
// `novo build --target=nrf54lm20-dk tests/device_read.nv`.

use embedded_hal.{ BoardI2c, BoardGpio }
use dev_bus
use dev_mag.{ MagNanoT, Magnetometer }
use qmc5883l
use qmc5883l.{ Qmc5883l }

// The part's address.
const ADDR = 0x0D

// A label and a number, written without building a string.
fn field(label: Str, v: Int) [hw]
    hal.uart.write(label)
    hal.uart.write(str.from_int(v))

@tier(embedded)
fn main() [hw]
    let part = Qmc5883l.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, dev_bus.wiring_i2c(0, ADDR))
    if not part.begin()
        hal.uart.write("qmc5883l: no answer\n")
        return
    loop
        match part.mag_read_new()
            Some(m) =>
                hal.uart.write("qmc5883l")
                field(" x=", m.x)
                field(" y=", m.y)
                field(" z=", m.z)
                hal.uart.write("\n")
            None    =>
                hal.timer.delay_ms(5)
