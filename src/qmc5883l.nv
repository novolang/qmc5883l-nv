// qmc5883l — QST's QMC5883L three-axis magnetometer, on its I2C bus, as
// devices-nv's `Magnetometer`, `Thermometer` and `Identifiable`.
//
// The facts below are from QST's data sheet "QMC5883L: 3-Axis Magnetic Sensor"
// (Rev. 1.0), in the copy that reproduces its text under a module
// maker's cover ("GY-271 Kompassmodul Kompass Magnet Sensor Datenblatt"; the
// page and table numbers below are that copy's, and the register map is
// Table 13).  The part has no document number in that copy.  Where the sheet and
// the drivers read for this one disagree, the site says which was taken.
//
// The register map (§ 12.1, Table 13), as this driver uses it:
//
//   0x00  DATA X LSB     0x01 DATA X MSB     16-bit two's complement words,
//   0x02  DATA Y LSB     0x03 DATA Y MSB     low byte first
//   0x04  DATA Z LSB     0x05 DATA Z MSB
//   0x06  STATUS         DOR (2), OVL (1), DRDY (0)
//   0x07  TOUT LSB       0x08 TOUT MSB       temperature, 16-bit two's complement
//   0x09  CTRL1          OSR (7:6), RNG (5:4), ODR (3:2), MODE (1:0)
//   0x0A  CTRL2          SOFT_RST (7), ROL_PNT (6), INT_ENB (0)
//   0x0B  SET/RESET      the period, to be written 0x01
//   0x0D  CHIP ID        0xFF; Rev. 1.0 lists 0x0C and 0x0D as reserved, and
//                        the chip id is the value the `qmc5883l` crate reads
//
// The measurement (§ 9.2).  The part has two modes, standby (the reset state)
// and continuous.  In continuous mode it measures at the output data rate (10,
// 50, 100 or 200 Hz, Table 18) with an oversampling ratio (512, 256, 128 or
// 64) and a range of ±2 or ±8 gauss.  The sensitivity is 12000 counts per
// gauss at ±2 gauss and 3000 at ±8 gauss (Table 2); the counts saturate at
// -32768 and 32767 and OVL says so.  One gauss is 100 000 nanotesla, so a
// count is 8.33 nT at ±2 gauss and 33.3 nT at ±8 gauss.
//
// Reading the data (§ 9.2.1.1, 9.2.1.3, 9.2.1.4).  A read of any of the six
// data registers clears DRDY and DOR and starts data protection: the data
// registers are not updated until the last one, 0x05, has been read.  So the
// driver always reads all six.  DRDY and DOR are read from STATUS alone, which
// is not a data register.
//
// The pointer roll-over (CTRL2's ROL_PNT, § 11.2.5) makes a read that begins at
// 0x00 to 0x06 wrap from 0x06 to 0x00, so with it set a burst of the data and
// the registers behind it would return the data twice.  The driver leaves it
// clear, which is the reset value, and reads the data, STATUS, the temperature
// and CTRL1 in one burst of ten registers.  STATUS in that burst is read after
// the data, so only its OVL flag is to be trusted there; the ready flag has its
// own read.
//
// The temperature (§ 12.2.3).  The sensor's gain is factory-calibrated, about
// 100 counts per degree, but "its offset has not been compensated, only
// relative temperature value is accurate".  The reading here is the count
// times ten, in milli-degrees, with zero at no particular temperature: it
// shows change, not an absolute temperature.
//
// The bus.  I2C only, at 0x0D (§ 8.4), up to 400 kHz, with pull-ups outside the
// part.  The sub-address is the register and the address advances by itself.
// A read is a write of the register and a repeated start.
//
// Drivers read for their fixes, nothing ported: the `qmc5883l` crate 0.0.1
// (heyitsanthony).  There is no Zephyr driver.  Each fix kept is named at its
// site.
//
// The driver holds no state: the range, the mode and the rate are read from the
// part in the same transaction as the sample.
//
// A bus enters through `Qmc5883lPort`, which a type that holds a bus implements:
// `Qmc5883l` for the I2C bus.  The framing is the generic functions
// `i2c_read_into` and `i2c_write`, so a test runs them over a double of the bus.

use embedded_hal.{ BoardI2c, BoardGpio, I2cBus, GpioOut, TimerAsync, AsyncEdge }
use dev_bus.{ DeviceWiring, DevBytes, RegPort }
use dev_mag.{ MagNanoT, MagRange, MagStatus, Magnetometer }
use dev_thermo.{ TempMilliC, TempKind, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let DATA_X_LSB = 0x00
let STATUS     = 0x06
let TOUT_LSB   = 0x07
let CTRL1      = 0x09
let CTRL2      = 0x0A
let SET_RESET  = 0x0B
let CHIP_ID    = 0x0D

// The chip id's value, and the period the SET/RESET register is to hold.
let ID_QMC5883L = 0xFF
let PERIOD_REC  = 0x01

// CTRL1: the four fields.
let CTRL1_OSR_MASK  = 0xC0
let CTRL1_RNG_MASK  = 0x30
let CTRL1_ODR_MASK  = 0x0C
let CTRL1_MODE_MASK = 0x03
let MODE_CONTINUOUS = 0x01
// CTRL2: the soft reset, the pointer roll-over and the interrupt disable.
let CTRL2_SOFT_RST = 0x80
let CTRL2_INT_ENB  = 0x01
// STATUS: the flags.
let STATUS_DRDY = 0x01
let STATUS_OVL  = 0x02
let STATUS_DOR  = 0x04

// One gauss in nanotesla, and the counts per gauss at the two ranges.
let NT_PER_GAUSS = 100000
let COUNTS_2G    = 12000
let COUNTS_8G    = 3000

// The clock `setup` asks for: I2C fast mode.
let I2C_HZ = 400000

// The most polls of a flag one wait makes.  A soft reset takes no more than a
// few hundred microseconds and a read over I2C about 100 us.
let RESET_POLLS = 100

// The full-scale range (Table 18).
pub @value
enum QmcRange
    QmcRange2G
    QmcRange8G

// The operation mode (Table 18); the other two codes are reserved.
pub @value
enum QmcMode
    QmcStandby
    QmcContinuous

// A bus the part is on. `RegPort` is the register access, `read_regs` and
// `write_reg`, with the register reads and writes built on them; `setup`
// makes the bus and the pins ready and answers whether the wiring suits
// the bus; `irq_level` answers the level of the DRDY pin.
pub trait Qmc5883lPort: RegPort
    fn setup(self) -> Bool [hw]
    fn irq_level(self) -> Int [hw]

// ── The bus ──────────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a write of
// the register and a repeated start: whether the part answered.  The address
// advances by itself.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the part
// acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Makes an I2C bus ready: the DRDY pin an input, the bus at 400 kHz.  The
// wiring needs an address, which the answer says.
pub @deprecated(since = "0.3.0", replace_with = "dev_bus.wiring_i2c_setup")
fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    dev_bus.wiring_i2c_setup(bus, gpio, w, I2C_HZ)

// The level of the part's DRDY line on the board, 1 or 0, or -1 for a wiring
// with no pin.
pub @deprecated(since = "0.3.0", replace_with = "dev_bus.wiring_irq_level")
fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    dev_bus.wiring_irq_level(gpio, w)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub @deprecated(since = "0.3.0", replace_with = "RegPort.read_reg")
fn reg_read<P: Qmc5883lPort>(p: P, reg: Int) -> ?Int [hw]
    p.read_reg(reg)

// Writes `v` to the register `reg` and reads it back: whether the part holds
// the value.  A register with a bit that clears itself is written with
// `write_reg`.
pub @deprecated(since = "0.3.0", replace_with = "RegPort.write_reg_verified")
fn reg_write<P: Qmc5883lPort>(p: P, reg: Int, v: Int) -> Bool [hw]
    p.write_reg_verified(reg, v)

// Sets the bits of `mask` in `reg` to the bits of `bits`, leaving the others:
// whether the part took it.
//
// Fix kept: the `qmc5883l` crate clears a field with a mask that is not the
// field's: its range constant is bit 3, where the range is bits 5 and 4 and bit
// 3 belongs to the data rate, so setting ±8 gauss raises the rate (10 Hz becomes
// 100 Hz, 50 Hz becomes 200 Hz) and leaves the range at ±2.  Every setting here
// changes its own bits of the register read from the part.
pub @deprecated(since = "0.3.0", replace_with = "RegPort.update_reg_verified")
fn reg_update<P: Qmc5883lPort>(p: P, reg: Int, mask: Int, bits: Int) -> Bool [hw]
    p.update_reg_verified(reg, mask, bits)

// ── Identity ─────────────────────────────────────────────────────────

// The chip id as a `DeviceId`, or `None` when no part answers.  An I2C part
// that is present answers 0xFF; a part that is absent does not acknowledge.
pub fn id_read<P: Qmc5883lPort>(p: P) -> ?DeviceId [hw]
    match p.read_reg(CHIP_ID)
        Some(who) => Some(DeviceId { who: who, rev: None })
        None      => None

// ── Conversions ──────────────────────────────────────────────────────

// The range a CTRL1 byte selects.  The two reserved codes are read as ±8
// gauss, which is the larger.
pub fn range_of_ctrl1(v: Int) -> QmcRange
    match (v >> 4) & 3
        0 => QmcRange2G
        _ => QmcRange8G

// The RNG field for a range.
pub fn rng_of_range(r: QmcRange) -> Int
    match r
        QmcRange2G => 0
        QmcRange8G => 1

// The trait's range for the part's: `MagRange2G` or `MagRange8G`.
pub fn mag_range_of(r: QmcRange) -> MagRange
    match r
        QmcRange2G => MagRange.MagRange2G
        QmcRange8G => MagRange.MagRange8G

// The part's range for the trait's, or `None` for a range the part does not
// have: it measures at ±2 or ±8 gauss only.
pub fn qmc_range_of(r: MagRange) -> ?QmcRange
    match r
        MagRange.MagRange2G => Some(QmcRange.QmcRange2G)
        MagRange.MagRange8G => Some(QmcRange.QmcRange8G)
        _                   => None

// The counts per gauss of a range: 12000 at ±2 gauss, 3000 at ±8 (Table 2).
pub fn counts_per_gauss(r: QmcRange) -> Int
    match r
        QmcRange2G => COUNTS_2G
        QmcRange8G => COUNTS_8G

// The field in nanotesla that a count means at a range, rounded toward zero.
pub fn nano_t_of(count: Int, r: QmcRange) -> Int
    count * NT_PER_GAUSS / counts_per_gauss(r)

// The mode a CTRL1 byte selects; the reserved codes are read as standby.
pub fn mode_of_ctrl1(v: Int) -> QmcMode
    match v & 3
        1 => QmcContinuous
        _ => QmcStandby

// The rate in hertz a CTRL1 byte selects (Table 18).
pub fn rate_hz_of_ctrl1(v: Int) -> Int
    match (v >> 2) & 3
        0 => 10
        1 => 50
        2 => 100
        _ => 200

// The ODR code of the slowest rate at or above `hz`, or of the fastest, 200 Hz.
pub fn odr_for_rate(hz: Int) -> Int
    if hz <= 10
        return 0
    if hz <= 50
        return 1
    if hz <= 100
        return 2
    3

// The oversampling ratio a CTRL1 byte selects: 512, 256, 128 or 64.
pub fn osr_of_ctrl1(v: Int) -> Int
    match (v >> 6) & 3
        0 => 512
        1 => 256
        2 => 128
        _ => 64

// The OSR code of the smallest ratio at or above `n`, or of 512.
pub fn osr_code_for(n: Int) -> Int
    if n <= 64
        return 3
    if n <= 128
        return 2
    if n <= 256
        return 1
    0

// ── Samples ──────────────────────────────────────────────────────────

// The signed 16-bit count at byte `i` of `b`, low byte first.
fn count(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i + 1] as Int << 8) | b[i] as Int, 16)

// The most recent sample in nanotesla, from one burst of ten registers, 0x00 to
// 0x09: the three axes, STATUS, the temperature and CTRL1, so the range it is
// converted with is the one it was taken in.  `None` when the part did not
// answer.  A count that saturated reads as the count it saturated at; the flag
// is `overflow_read`'s.  In standby the registers hold the last measurement.
pub fn sample_read<P: Qmc5883lPort>(p: P) -> ?MagNanoT [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(DATA_X_LSB, 10, var b)
        return None
    let r = range_of_ctrl1(b[9] as Int)
    Some(MagNanoT { x: nano_t_of(count(b, 0), r),
        y: nano_t_of(count(b, 2), r),
        z: nano_t_of(count(b, 4), r) })

// STATUS whole, or 0 when the part did not answer.  Reading it does not clear
// DRDY or DOR; only a read of a data register does.
pub fn status_read<P: Qmc5883lPort>(p: P) -> Int [hw]
    p.read_reg(STATUS) ?? 0

// Whether a STATUS byte says a new set of data is ready.
pub fn status_ready(v: Int) -> Bool
    (v & STATUS_DRDY) != 0

// Whether a STATUS byte says an axis is out of range.
pub fn status_overflow(v: Int) -> Bool
    (v & STATUS_OVL) != 0

// Whether a STATUS byte says a set of data was skipped before the next one
// came.
pub fn status_missed(v: Int) -> Bool
    (v & STATUS_DOR) != 0

// Whether a new set of data has been written since the last read of a data
// register: STATUS's DRDY.
pub fn sample_ready<P: Qmc5883lPort>(p: P) -> Bool [hw]
    status_ready(status_read(p))

// Whether an axis of the last measurement was out of range: STATUS's OVL.  The
// counts then sit at -32768 or 32767.
pub fn overflow_read<P: Qmc5883lPort>(p: P) -> Bool [hw]
    status_overflow(status_read(p))

// What STATUS says of the sample, in the trait's terms: `MagOverflow` when OVL is
// set, since an axis then sits at -32768 or 32767; otherwise `MagNotReady` when
// DRDY is clear, and `MagValid` when it is set.  A read of a data register clears
// DRDY (§ 9.2.1.1), so the answer after a `mag_read` is `MagNotReady` until the
// next sample completes; OVL is not cleared by that read.
pub fn status_of(v: Int) -> MagStatus
    if status_overflow(v)
        return MagStatus.MagOverflow
    if status_ready(v)
        return MagStatus.MagValid
    MagStatus.MagNotReady

// The range from CTRL1 as the trait's, or `None` when the part did not answer.
pub fn mag_range_read<P: Qmc5883lPort>(p: P) -> ?MagRange [hw]
    match p.read_reg(CTRL1)
        Some(v) => Some(mag_range_of(range_of_ctrl1(v)))
        None    => None

// Sets the range the trait names.  The part has two, so any other answers
// `false` without a write.
pub fn mag_range_write<P: Qmc5883lPort>(p: P, r: MagRange) -> Bool [hw]
    match qmc_range_of(r)
        Some(q) => range_write(p, q)
        None    => false

// STATUS read on its own, which clears nothing, in the trait's terms.  A part
// that did not answer reads 0 and so is `MagNotReady`.
pub fn mag_status_read<P: Qmc5883lPort>(p: P) -> MagStatus [hw]
    status_of(status_read(p))

// The range the part is set to, ±2 gauss when it does not answer.
pub fn range_read<P: Qmc5883lPort>(p: P) -> QmcRange [hw]
    range_of_ctrl1(p.read_reg(CTRL1) ?? 0)

// Sets the range and leaves the other bits of CTRL1: whether the part took it.
pub fn range_write<P: Qmc5883lPort>(p: P, r: QmcRange) -> Bool [hw]
    p.update_reg_verified(CTRL1, CTRL1_RNG_MASK, rng_of_range(r) << 4)

// The mode the part is in, standby when it does not answer.
pub fn mode_read<P: Qmc5883lPort>(p: P) -> QmcMode [hw]
    mode_of_ctrl1(p.read_reg(CTRL1) ?? 0)

// Sets the mode and leaves the rest of CTRL1: whether the part took it.
pub fn mode_write<P: Qmc5883lPort>(p: P, m: QmcMode) -> Bool [hw]
    match m
        QmcStandby    => p.update_reg_verified(CTRL1, CTRL1_MODE_MASK, 0)
        QmcContinuous => p.update_reg_verified(CTRL1, CTRL1_MODE_MASK, MODE_CONTINUOUS)

// The rate the part measures at in hertz; 0 in standby and when it does not
// answer.
pub fn rate_read<P: Qmc5883lPort>(p: P) -> Int [hw]
    let v = p.read_reg(CTRL1) ?? 0
    if mode_of_ctrl1(v) == QmcStandby
        return 0
    rate_hz_of_ctrl1(v)

// Sets the slowest rate at or above `hz` and leaves the mode and the other
// fields: the rate the part took in hertz, or 0 when it did not take it.
pub fn rate_write<P: Qmc5883lPort>(p: P, hz: Int) -> Int [hw]
    let code = odr_for_rate(hz)
    if not p.update_reg_verified(CTRL1, CTRL1_ODR_MASK, code << 2)
        return 0
    rate_hz_of_ctrl1(code << 2)

// The oversampling ratio the part is set to, 512 when it does not answer.
pub fn osr_read<P: Qmc5883lPort>(p: P) -> Int [hw]
    osr_of_ctrl1(p.read_reg(CTRL1) ?? 0)

// Sets the smallest oversampling ratio at or above `n`, 64 to 512, and leaves
// the other fields: the ratio the part took, or 0 when it did not take it.  A
// larger ratio gives less noise and takes more current.
pub fn osr_write<P: Qmc5883lPort>(p: P, n: Int) -> Int [hw]
    let code = osr_code_for(n)
    if not p.update_reg_verified(CTRL1, CTRL1_OSR_MASK, code << 6)
        return 0
    osr_of_ctrl1(code << 6)

// Turns the DRDY pin on or off (CTRL2's INT_ENB, which is 1 for disabled, as
// Rev. 1.0 words it): whether the part took it.
//
// Fix kept: the `qmc5883l` crate's `enable_interrupt` writes CTRL2 whole, which
// would clear any other bit of it; this changes INT_ENB alone.
pub fn drdy_pin_write<P: Qmc5883lPort>(p: P, on: Bool) -> Bool [hw]
    if on
        return p.update_reg_verified(CTRL2, CTRL2_INT_ENB, 0)
    p.update_reg_verified(CTRL2, CTRL2_INT_ENB, CTRL2_INT_ENB)

// ── The temperature ──────────────────────────────────────────────────

// The die temperature in milli-degrees, from TOUT's two registers in one
// transaction: the count times ten, since 100 counts make a degree.  Only
// changes are meaningful (§ 12.2.3); zero is not 0 °C.  `None` when the part
// did not answer.
//
// Fix kept: the `qmc5883l` crate reads the two bytes in two transactions, and a
// new measurement between them gives a count from two samples.
pub fn temp_read_milli<P: Qmc5883lPort>(p: P) -> ?TempMilliC [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(TOUT_LSB, 2, var b)
        return None
    Some(TempMilliC { milli_c: count(b, 0) * 10 })

// Starts a temperature conversion, which the part does not need: it converts
// with the measurements.  Answers 0, or -1 when the part is in standby or does
// not answer, since it then keeps the last result.
pub fn temp_begin<P: Qmc5883lPort>(p: P) -> Int [hw]
    if mode_of_ctrl1(p.read_reg(CTRL1) ?? 0) == QmcStandby
        return -1
    0

// ── Waiting on a host's scheduler ────────────────────────────────────
//
// The function below is `@tier(rt)` because the package checks at the embedded
// tier, which refuses an `async fn` that is not bounded.  It waits on a
// `TimerAsync` the caller gives, since a driver value is `@value` and an
// `async fn` takes none (SPEC § 14.5): `MagnetometerAsync` cannot be
// implemented by `Qmc5883l`.  A program at `@tier(embedded)` arms the DRDY pin
// through `irq_arm` and the board's `AsyncEdge` instead.

// Stays an inherent function: planning/PERIPHERAL-DRIVER-CANDIDATES.md § 3.5,
// row "the async forms" (a `@value` driver cannot implement `MagnetometerAsync`,
// and the embedded tier refuses `async fn`).
//
// Parks the task until the next sample is complete and answers it: the
// data-ready flag is polled every `period_us`, at most `tries` times.  The part
// measures in the background in continuous mode, so the task is free in
// between.
pub @tier(rt)
async fn mag_next<P: Qmc5883lPort, T: TimerAsync>(p: P, t: T, period_us: Int,
                                                  tries: Int) -> ?MagNanoT [hw, async]
    for _i in 0..tries
        if sample_ready(p)
            return sample_read(p)
        await t.sleep_us(period_us)
    None

// Stays an inherent function: planning/PERIPHERAL-DRIVER-CANDIDATES.md § 3.5,
// row "the async forms" (no board's GPIO implements `AsyncEdge`).
//
// Arms the part's DRDY pin on a rising edge through a board's pin-edge source:
// 0 when armed, a negative value when refused, and -1 for a wiring with no pin.
// The edge resolves `f`.  The pin must be enabled, which `begin` leaves it.
pub fn irq_arm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring, f: Future) -> Int [e]
    let Some(irq) = w.irq else return -1
    edge.edge_arm(irq, 0, f)

// Takes the arm back: whether it was still armed.  False for a wiring with no
// pin.
pub fn irq_disarm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring) -> Bool [e]
    let Some(irq) = w.irq else return false
    edge.edge_disarm(irq)

// ── Bring-up ─────────────────────────────────────────────────────────

// Resets every register with CTRL2's SOFT_RST and waits for the bit to clear:
// whether it did.  The reset puts the part in standby.
pub fn soft_reset<P: Qmc5883lPort>(p: P) -> Bool [hw]
    if not p.write_reg(CTRL2, CTRL2_SOFT_RST)
        return false
    for _i in 0..RESET_POLLS
        let Some(v) = p.read_reg(CTRL2) else return false
        if (v & CTRL2_SOFT_RST) == 0
            return true
    false

// Brings the part up: the bus made ready; the chip id checked; a soft reset;
// the SET/RESET period written 0x01, which Rev. 1.0 says it is to hold (§
// 12.2.5; the reset leaves it 0); then continuous mode at 10 Hz, ±2 gauss and
// an oversampling ratio of 512, with the DRDY pin left enabled as the reset
// leaves it.  Answers whether the part answered as a QMC5883L and took every
// setting.
//
// Fix kept: the SET/RESET period is rewritten after every reset, since the reset
// clears it; the `qmc5883l` crate does the same.  The chip id is read before the
// reset, as the crate does.
pub fn start<P: Qmc5883lPort>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if p.read_reg(CHIP_ID) != Some(ID_QMC5883L)
        return false
    if not soft_reset(p)
        return false
    p.write_reg_verified(SET_RESET, PERIOD_REC) and p.write_reg_verified(CTRL1, MODE_CONTINUOUS)

// ── The part on an I2C bus ───────────────────────────────────────────

// A QMC5883L on a board's I2C bus at the address `w.addr`, 0x0D, with the
// board's GPIO for the DRDY line.
pub @value
struct Qmc5883l
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl RegPort for Qmc5883l
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

impl Qmc5883lPort for Qmc5883l
    fn setup(self) -> Bool [hw]
        dev_bus.wiring_i2c_setup(self.bus, self.pins, self.w, I2C_HZ)

    fn irq_level(self) -> Int [hw]
        dev_bus.wiring_irq_level(self.pins, self.w)

impl Qmc5883l
    // The part at `w.addr` on the board's I2C bus, as a board's device table
    // builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Qmc5883l
        Qmc5883l { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        self.read_reg(r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        self.write_reg_verified(r, v)

    // The operation mode.
    fn mode(self) -> QmcMode [hw]
        mode_read(self)

    // Sets the operation mode (`mode_write`).
    fn set_mode(self, m: QmcMode) -> Bool [hw]
        mode_write(self, m)

    // Sets the slowest rate at or above `hz` (`rate_write`).
    fn set_rate_hz(self, hz: Int) -> Int [hw]
        rate_write(self, hz)

    // The oversampling ratio.
    fn oversampling(self) -> Int [hw]
        osr_read(self)

    // Sets the oversampling ratio (`osr_write`).
    fn set_oversampling(self, n: Int) -> Int [hw]
        osr_write(self, n)

    // Turns the DRDY pin on or off (`drdy_pin_write`).
    fn set_drdy_pin(self, on: Bool) -> Bool [hw]
        drdy_pin_write(self, on)

impl Magnetometer[hw] for Qmc5883l
    fn mag_read(self) -> ?MagNanoT [hw]
        sample_read(self)

    fn mag_ready(self) -> Bool [hw]
        sample_ready(self)

    fn mag_rate_hz(self) -> Int [hw]
        rate_read(self)

    fn mag_range(self) -> ?MagRange [hw]
        mag_range_read(self)

    fn mag_set_range(self, r: MagRange) -> Bool [hw]
        mag_range_write(self, r)

    fn mag_status(self) -> MagStatus [hw]
        mag_status_read(self)

impl Thermometer[hw] for Qmc5883l
    // The offset is not compensated (§ 12.2.3): the reading shows change only.
    fn temp_kind(self) -> TempKind [hw]
        TempKind.TempRelative

    fn temp_start(self) -> Int [hw]
        temp_begin(self)

    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_milli(self)

impl Identifiable[hw] for Qmc5883l
    // The chip id, 0xFF; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)
